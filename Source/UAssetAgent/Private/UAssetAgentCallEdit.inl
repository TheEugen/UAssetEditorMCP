static UFunction* ResolveCallFunction(UBlueprint* BP, const FString& Owner, const FString& Name)
{
    UClass* Class = Owner == TEXT("self") ? BP->SkeletonGeneratedClass.Get() : LoadObject<UClass>(nullptr, *Owner);
    Require(Class != nullptr, TEXT("Function class not found: ") + Owner);
    UFunction* Function = Class->FindFunctionByName(FName(*Name));
    Require(Function && Function->HasAnyFunctionFlags(FUNC_BlueprintCallable | FUNC_BlueprintPure),
        TEXT("Blueprint callable function not found: ") + Name);
    return Function;
}

static void SetCallFunction(UK2Node_CallFunction* Call, const FString& Owner, const UFunction* Function)
{
    Call->SetFromFunction(Function);
    if (Owner == TEXT("self")) { Call->FunctionReference.SetSelfMember(Function->GetFName()); }
}

struct FCallPinDefault
{
    FEdGraphPinType Type;
    FString Value;
    UObject* Object;
    FText Text;
};

struct FCallPinState
{
    FName Source;
    FName Target;
    EEdGraphPinDirection Direction;
    TArray<FEdGraphPinReference> Links;
    TOptional<FCallPinDefault> Default;
};

static UEdGraphPin* FindCallPin(const UK2Node_CallFunction* Call, const FString& Key, EEdGraphPinDirection Direction = EGPD_MAX)
{
    FGuid Id;
    const bool ById = FGuid::Parse(Key, Id);
    UEdGraphPin* Found = nullptr;
    for (UEdGraphPin* Pin : Call->Pins)
    {
        if (!Pin || Pin->bOrphanedPin || (Direction != EGPD_MAX && Pin->Direction != Direction) ||
            (ById ? Pin->PinId != Id : Pin->PinName != FName(*Key))) { continue; }
        Require(!Found, TEXT("Ambiguous call pin. Use the old pin GUID in pin_map: ") + Key);
        Found = Pin;
    }
    return Found;
}

static void RetargetCall(UBlueprint* BP, UK2Node_CallFunction* Call, const FJson& Op, const UEdGraphSchema_K2* Schema)
{
    const FString Owner = String(Op, TEXT("class"), CallFunctionClass(Call), false);
    Require(!Owner.IsEmpty(), TEXT("The old call class could not be resolved. Specify class explicitly"));
    const UFunction* Function = ResolveCallFunction(BP, Owner, String(Op, TEXT("function")));

    TMap<const UEdGraphPin*, FName> PinMap;
    if (Op->HasField(TEXT("pin_map")))
    {
        for (const auto& Pair : Object(Op, TEXT("pin_map"))->Values)
        {
            FString Target;
            Require(Pair.Value->TryGetString(Target) && !Target.TrimStartAndEnd().IsEmpty(),
                TEXT("Pin map values must be replacement pin names"));
            const UEdGraphPin* Pin = FindCallPin(Call, Pair.Key);
            Require(Pin && !PinMap.Contains(Pin), TEXT("Pin map has a missing or duplicate source pin: ") + Pair.Key);
            PinMap.Add(Pin, FName(*Target));
        }
    }

    TArray<FCallPinState> States;
    for (const UEdGraphPin* Pin : Call->Pins)
    {
        if (!Pin) { continue; }
        Require(!Pin->bOrphanedPin || Pin->LinkedTo.IsEmpty(), TEXT("Disconnect the linked orphaned call pin first: ") + Pin->PinName.ToString());
        if (Pin->bOrphanedPin) { continue; }
        const FName* Mapped = PinMap.Find(Pin);
        const bool HasDefault = Pin->Direction == EGPD_Input && Pin->LinkedTo.IsEmpty() &&
            Pin->PinType.PinCategory != UEdGraphSchema_K2::PC_Exec && !Pin->bHidden && !Pin->bDefaultValueIsIgnored &&
            !Pin->bDefaultValueIsReadOnly && !Pin->DoesDefaultValueMatchAutogenerated();
        if (!Mapped && !HasDefault && Pin->LinkedTo.IsEmpty()) { continue; }
        FCallPinState& State = States.Add_GetRef({Pin->PinName, Mapped ? *Mapped : Pin->PinName, Pin->Direction, {}, {}});
        for (const UEdGraphPin* Linked : Pin->LinkedTo) { State.Links.Emplace(Linked); }
        if (HasDefault) { State.Default.Emplace(FCallPinDefault{Pin->PinType, Pin->DefaultValue, Pin->DefaultObject, Pin->DefaultTextValue}); }
    }

    Call->Modify();
    for (UEdGraphPin* Pin : Call->Pins)
    {
        if (!Pin || Pin->bOrphanedPin) { continue; }
        // The replacement gets its own generated defaults and links are restored using this operation's map.
        Pin->BreakAllPinLinks();
        if (Pin->Direction == EGPD_Input && Pin->PinType.PinCategory != UEdGraphSchema_K2::PC_Exec)
        { Schema->ResetPinToAutogeneratedDefaultValue(Pin, false); }
    }
    SetCallFunction(Call, Owner, Function);
    const bool Previous = Call->bDisableOrphanPinSaving;
    Call->bDisableOrphanPinSaving = true;
    Call->ReconstructNode();
    Call->bDisableOrphanPinSaving = Previous;

    TSet<UEdGraphPin*> Destinations;
    for (const FCallPinState& State : States)
    {
        const FString Source = State.Source.ToString();
        const FString Target = State.Target.ToString();
        UEdGraphPin* Pin = FindCallPin(Call, Target, State.Direction);
        Require(Pin != nullptr, TEXT("Replacement pin missing for ") + Source + TEXT(". Check pin_map or disconnect the old use first"));
        Require(!Destinations.Contains(Pin), TEXT("Multiple pins map to replacement pin: ") + Target);
        Destinations.Add(Pin);
        if (const FCallPinDefault* Default = State.Default.GetPtrOrNull())
        {
            Require(!Pin->bHidden && !Pin->bDefaultValueIsIgnored && !Pin->bDefaultValueIsReadOnly &&
                Schema->ArePinTypesCompatible(Default->Type, Pin->PinType, BP->SkeletonGeneratedClass),
                TEXT("Replacement pin cannot preserve the default on: ") + Source);
            const FString Error = Schema->IsPinDefaultValid(Pin, Default->Value, Default->Object, Default->Text);
            Require(Error.IsEmpty(), TEXT("Invalid default for replacement pin ") + Target + TEXT(": ") + Error);
            if (Pin->PinType.PinCategory == UEdGraphSchema_K2::PC_Text) { Schema->TrySetDefaultText(*Pin, Default->Text); }
            else if (Default->Object) { Schema->TrySetDefaultObject(*Pin, Default->Object); }
            else { Schema->TrySetDefaultValue(*Pin, Default->Value); }
        }
    }
    for (const FCallPinState& State : States)
    {
        for (const FEdGraphPinReference& Link : State.Links)
        {
            UEdGraphPin* Pin = FindCallPin(Call, State.Target.ToString(), State.Direction);
            UEdGraphPin* Other = Link.Get();
            UEdGraphPin* From = State.Direction == EGPD_Output ? Pin : Other;
            UEdGraphPin* To = State.Direction == EGPD_Input ? Pin : Other;
            Require(From && To && !Other->bOrphanedPin && Schema->CanCreateConnection(From, To).Response == CONNECT_RESPONSE_MAKE &&
                Schema->TryCreateConnection(From, To), TEXT("Replacement cannot preserve the connection on: ") + State.Source.ToString());
        }
    }
}
